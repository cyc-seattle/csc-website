---
import Base from "../layouts/Base.astro";
---

<Base title="Page Not Found">
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <h1 class="text-4xl font-black text-navy">Page Not Found</h1>
    <p class="mt-4 text-lg text-slate-600">We couldn't find that page. It may have moved.</p>
    <a class="button mt-8" href="/">
      Go to the home page
    </a>
  </section>
</Base>
