---
import Base from "../layouts/Base.astro";
import Banner from "../components/Banner.astro";
import Card from "../components/Card.astro";
import { categories, page, settings } from "../lib/content.ts";

const home = page("home");
const statusLabel = { open: "Registration open", coming_soon: "Coming soon", closed: "" } as const;
---

<Base title={settings.name} description={settings.description} shareImage={home.banner}>
  <Banner title={home.title} image={home.banner} tall />
  <section class="mx-auto max-w-6xl px-4 py-12">
    <p class="mx-auto max-w-3xl text-center text-lg leading-relaxed text-slate-600">{settings.description}</p>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {categories.map((c) => (
        <li class="flex">
          <Card
            title={c.title}
            image={c.image}
            href={`/program-category/${c.slug}`}
            tag={statusLabel[c.status] || undefined}
            heading="h2"
          >
            <p class="flex-1 text-sm">{c.summary}</p>
            <a class="text-sm font-bold text-signal hover:underline" href={`/program-category/${c.slug}`}>
              See programs →
            </a>
          </Card>
        </li>
      ))}
    </ul>
  </section>
</Base>
