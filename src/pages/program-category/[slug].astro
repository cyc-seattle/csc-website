---
import Base from "../../layouts/Base.astro";
import Banner from "../../components/Banner.astro";
import Markdown from "../../components/Markdown.astro";
import ProgramGroup from "../../components/ProgramGroup.astro";
import Notice from "../../components/Notice.astro";
import Faqs from "../../components/Faqs.astro";
import Profiles from "../../components/Profiles.astro";
import Gallery from "../../components/Gallery.astro";
import { categories, type Category } from "../../lib/content.ts";

export function getStaticPaths() {
  return categories.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}
const { category: c } = Astro.props as { category: Category };
---

<Base title={c.title} description={c.summary} shareImage={c.image}>
  <Banner title={c.title} image={c.banner ?? c.image} />
  <Notice status={c.status} opensOn={c.opensOn} />
  <section class="mx-auto max-w-6xl px-4 pt-8 text-center">
    <Markdown source={c.top} class="mx-auto text-center" />
  </section>
  {c.programs.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-10">
      <ProgramGroup programs={c.programs} status={c.status} />
    </section>
  )}
  {c.testimonial && (
    <figure class="mx-auto my-6 max-w-6xl px-4 text-center">
      <blockquote class="mx-auto max-w-3xl text-xl italic leading-relaxed text-navy">“{c.testimonial}”</blockquote>
    </figure>
  )}
  {c.bottom && (
    <section class="mx-auto max-w-6xl overflow-x-auto px-4 py-10">
      <Markdown source={c.bottom} />
    </section>
  )}
  <Faqs topics={c.faqTopics} />
  <Profiles compact title="Meet Our Crew" items={c.profiles} />
  <Gallery ids={c.gallery} />
</Base>
