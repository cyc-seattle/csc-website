---
// The page a form sends a visitor to. It's out of search results and the sitemap (src/lib/result-pages.ts).
import Base from "../layouts/Base.astro";

interface Props {
  title: string;
  link: { href: string; label: string };
}
const { title, link } = Astro.props;
---

<Base title={title} noindex>
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <h1 class="text-4xl font-black text-navy">{title}</h1>
    <div class="mt-4 space-y-2 text-lg text-slate-600">
      <slot />
    </div>
    <a class="button mt-8" href={link.href}>
      {link.label}
    </a>
  </section>
</Base>
