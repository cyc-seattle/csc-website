---
import Markdown from "./Markdown.astro";
import SectionHeading from "./SectionHeading.astro";
import type { FaqTopic } from "../lib/content.ts";

interface Props {
  topics: FaqTopic[];
}
const { topics } = Astro.props;
---

{topics.length > 0 && (
  <section class="py-12">
    <div class="mx-auto max-w-3xl px-4">
      <SectionHeading>Frequently Asked Questions</SectionHeading>
      {topics.map((t) => (
        <div class="mb-8">
          <h3 class="mb-2 text-[13px] font-bold uppercase tracking-widest text-navy">{t.heading}</h3>
          <div class="card divide-y divide-line">
            {t.questions.map(({ question, answer }) => (
              <details class="group px-4 py-3">
                <summary class="cursor-pointer list-none font-bold text-navy marker:hidden">
                  <span class="mr-2 inline-block transition group-open:rotate-90">›</span>
                  {question}
                </summary>
                <Markdown source={answer} class="mt-2 prose-sm" />
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
)}
