---
import Markdown from "./Markdown.astro";
import type { FaqTopic } from "../lib/content.ts";

interface Props {
  topics: FaqTopic[];
}
const { topics } = Astro.props;
---

{topics.length > 0 && (
  <section class="bg-sea py-12">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="mb-6 text-center text-3xl font-black text-navy">Frequently Asked Questions</h2>
      {topics.map((t) => (
        <div class="mb-8">
          <h3 class="mb-3 text-xl font-bold text-navy">{t.heading}</h3>
          <div class="divide-y divide-slate-200 rounded-lg bg-white shadow-sm">
            {t.questions.map(({ question, answer }) => (
              <details class="group px-4 py-3">
                <summary class="cursor-pointer list-none font-bold text-navy marker:hidden">
                  <span class="mr-2 inline-block transition group-open:rotate-90">›</span>
                  {question}
                </summary>
                <Markdown source={answer} class="mt-2 prose-sm" />
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
)}
