---
import Img from "./Img.astro";
import { programAction, type Program, type Status } from "../lib/content.ts";

interface Props {
  program: Program;
  status: Status;
  flip?: boolean;
}
const { program: p, status, flip = false } = Astro.props;
const action = programAction(p, status);
const href = `/program/${p.slug}`;
---

<article class="grid items-center gap-6 overflow-hidden rounded-2xl bg-white shadow-md ring-1 ring-slate-100 md:grid-cols-2">
  <a href={href} class:list={["block h-full", flip && "md:order-2"]}>
    <Img id={p.cardImage} alt={p.title} class="h-64 w-full object-cover md:h-full" />
  </a>
  <div class="p-6 md:p-8">
    <h3 class="text-2xl font-black text-navy">
      <a href={href} class="hover:underline">
        {p.title}
      </a>
    </h3>
    {p.subtitle && <p class="font-bold tracking-wide text-signal uppercase">{p.subtitle}</p>}
    <p class="mt-3 leading-relaxed text-slate-600">{p.summary}</p>
    <div class="mt-5 flex flex-wrap gap-3">
      <a class="button" href={action.href}>
        {action.label}
      </a>
      {action.href !== href && (
        <a class="button-quiet" href={href}>
          Details
        </a>
      )}
    </div>
  </div>
</article>
