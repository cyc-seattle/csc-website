---
// One week's or day's cell in a schedule: navy with spots left, gray when full, or striped when nothing runs.
import { weekSpots, type DateRow } from "../lib/content.ts";

interface Props {
  row: DateRow | undefined;
  /** The week's days, written in the cell where no column heading says them, as on a phone card. */
  days?: string | undefined;
}
const { row, days } = Astro.props;
const state = row === undefined ? "off" : row.left === 0 ? "full" : "on";
---

<span class:list={["schedule-cell", `schedule-cell-${state}`, days && "flex-col"]}>
  {days && <span class:list={["font-normal", state === "on" ? "text-white/75" : "text-slate-500"]}>{days}</span>}
  {row ? weekSpots(row) : <span class="sr-only">No camp</span>}
</span>
