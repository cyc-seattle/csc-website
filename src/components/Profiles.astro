---
import Img from "./Img.astro";
import Markdown from "./Markdown.astro";
import type { Profile } from "../lib/content.ts";

interface Props {
  title: string;
  items: Profile[];
  /** Small cards with the bio folded away, for a category page's crew. */
  compact?: boolean;
}
const { title, items, compact = false } = Astro.props;
---

{items.length > 0 && (
  <section class="mx-auto max-w-6xl px-4 py-10">
    <h2 class="mb-6 text-center text-3xl font-black text-navy">{title}</h2>
    {compact ? (
      <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-5">
        {items.map((p) => (
          <article class="text-center">
            <Img
              id={p.photo}
              alt={p.name}
              widths={[200, 400]}
              sizes="200px"
              class="mx-auto aspect-square w-36 rounded-full object-cover shadow-md"
            />
            <h3 class="mt-3 font-black text-navy">{p.name}</h3>
            <p class="text-xs font-bold tracking-wide text-signal uppercase">{p.title}</p>
            {p.bio && (
              <details class="mt-1 text-left text-sm text-slate-600">
                <summary class="cursor-pointer text-center text-navy underline">About {p.name.split(" ")[0]}</summary>
                <Markdown source={p.bio} class="mt-2 prose-sm" />
              </details>
            )}
          </article>
        ))}
      </div>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((p) => (
          <article class="overflow-hidden rounded-xl bg-white shadow-md ring-1 ring-slate-100">
            <Img
              id={p.photo}
              alt={p.name}
              widths={[400, 800]}
              sizes="(min-width: 1024px) 33vw, 100vw"
              class="aspect-square w-full object-cover"
            />
            <div class="p-5">
              <h3 class="text-lg font-black text-navy">{p.name}</h3>
              <p class="text-sm font-bold tracking-wide text-signal uppercase">{p.title}</p>
              {p.bio && <Markdown source={p.bio} class="mt-3 prose-sm" />}
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
)}
