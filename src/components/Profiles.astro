---
import Person from "./Person.astro";
import SectionHeading from "./SectionHeading.astro";
import type { Profile } from "../lib/content.ts";

interface Props {
  title: string;
  items: Profile[];
  /** Smaller cards with the bio folded away, for a category page's crew. */
  compact?: boolean;
}
const { title, items, compact = false } = Astro.props;
---

{items.length > 0 && (
  <section class="mx-auto max-w-6xl px-4 py-12">
    <SectionHeading>{title}</SectionHeading>
    {/* A row that isn't full is centered, under the centered heading. */}
    <div class:list={["flex flex-wrap items-start justify-center", compact ? "gap-4" : "gap-5"]}>
      {items.map((p) => (
        <div
          class:list={
            compact
              ? "w-[calc((100%-1rem)/2)] sm:w-[calc((100%-2rem)/3)] lg:w-[calc((100%-5rem)/6)]"
              : "w-full sm:w-[calc((100%-1.25rem)/2)] lg:w-[calc((100%-3.75rem)/4)]"
          }
        >
          <Person person={p} folded={compact} />
        </div>
      ))}
    </div>
  </section>
)}
