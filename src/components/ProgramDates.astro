---
import { dayRange, dollars, type DateGroup } from "../lib/content.ts";

interface Props {
  groups: DateGroup[];
}
const { groups } = Astro.props;
// With one form, the page's own Register buttons are enough.
const each = groups.length > 1;
---

{groups.map((g) => (
  <section class="my-8">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <h2 class="text-2xl font-black text-navy">{g.form}</h2>
      {each && g.registerUrl && (
        <a class="button" href={g.registerUrl}>
          Register
        </a>
      )}
    </div>
    <table class="mt-4 w-full text-left">
      <thead class="sr-only">
        <tr>
          <th scope="col">Offering</th>
          <th scope="col">Dates</th>
          <th scope="col">Price</th>
          <th scope="col">Spots</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200 border-y border-slate-200">
        {g.rows.map((r) => (
          <tr>
            <th scope="row" class="py-3 pr-4 font-bold text-navy">
              {r.label}
            </th>
            <td class="py-3 pr-4">{dayRange(r.startsOn, r.endsOn)}</td>
            <td class="py-3 pr-4 text-right tabular-nums">{r.priceCents === null ? "" : dollars(r.priceCents)}</td>
            <td class="py-3 text-right text-sm font-bold text-signal">{r.spots}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
))}
