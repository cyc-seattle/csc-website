---
// The card a schedule sits in, with its title.
interface Props {
  /** Left out where a heading right above already names the schedule. */
  title?: string;
  class?: string;
}
const { title, class: className } = Astro.props;
---

<div class:list={["card p-4", className]}>
  {title && <p class="schedule-title">{title}</p>}
  <slot />
</div>
